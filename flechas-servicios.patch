diff --git a/styles.css b/styles.css
index 6595c48..032c507 100644
--- a/styles.css
+++ b/styles.css
@@ -4905,3 +4905,46 @@ footer a {
   font-size: 14px;
   font-weight: 700;
 }
+
+/* Flechas para recorrer los servicios desde el hero del detalle */
+.detail-hero-arrows { position: absolute; inset: 0; z-index: 2; pointer-events: none; }
+.detail-arrow {
+  position: absolute;
+  top: calc(50% + 34px);
+  display: grid;
+  place-items: center;
+  width: 72px;
+  height: 120px;
+  margin-top: -60px;
+  color: #f5fbf8;
+  opacity: .5;
+  pointer-events: auto;
+  -webkit-tap-highlight-color: transparent;
+  transition: opacity .25s ease, transform .25s ease;
+}
+.detail-arrow-prev { left: max(4px, calc((100vw - 1500px) / 2)); }
+.detail-arrow-next { right: max(4px, calc((100vw - 1500px) / 2)); }
+.detail-arrow svg {
+  width: 30px;
+  height: 50px;
+  fill: none;
+  stroke: currentColor;
+  stroke-width: 2.4;
+  stroke-linecap: round;
+  stroke-linejoin: round;
+  filter: drop-shadow(0 2px 10px rgba(4, 24, 33, .55));
+}
+.detail-arrow:hover, .detail-arrow:focus-visible { opacity: .95; }
+.detail-arrow-prev:hover, .detail-arrow-prev:focus-visible { transform: translateX(-4px); }
+.detail-arrow-next:hover, .detail-arrow-next:focus-visible { transform: translateX(4px); }
+.detail-arrow:focus-visible { outline: 2px solid rgba(245, 251, 248, .85); outline-offset: -6px; border-radius: 18px; }
+@media (max-width: 980px) {
+  .detail-arrow { top: 40%; width: 44px; height: 96px; margin-top: -48px; opacity: .55; }
+  .detail-arrow-prev { left: 0; }
+  .detail-arrow-next { right: 0; }
+  .detail-arrow svg { width: 22px; height: 38px; stroke-width: 2.6; }
+}
+@media (prefers-reduced-motion: reduce) {
+  .detail-arrow { transition: opacity .01s; }
+  .detail-arrow-prev:hover, .detail-arrow-next:hover, .detail-arrow-prev:focus-visible, .detail-arrow-next:focus-visible { transform: none; }
+}
