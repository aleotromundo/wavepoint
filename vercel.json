{
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": ".",
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    { "handle": "filesystem" },
    {
      "src": "^/(alojamiento-experiencias|clases-de-surf|surf-programa-3-dias|surf-coaching|roca-bruja|snorkel-catamaran|mangrove-tour|diving|local-host|yoga|atv|surf-fotografia|surfskate|retiros)/?$",
